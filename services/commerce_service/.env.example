# Copy to .env and fill in real values.
# Supabase Postgres connection string (psycopg async driver).
DATABASE_URL=postgresql+psycopg://postgres:postgres@localhost:5432/artisan
# Remote/Supabase example — keep the +psycopg scheme for the async driver:
# DATABASE_URL=postgresql+psycopg://postgres:<password>@db.<project-ref>.supabase.co:5432/postgres
DEBUG=false
ENVIRONMENT=development

STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
REDIS_URL=redis://localhost:6379/0
