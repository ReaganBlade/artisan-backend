# Copy to .env and fill in real values.
# Supabase Postgres connection string (psycopg async driver).
DATABASE_URL=postgresql+psycopg://postgres:postgres@localhost:5432/artisan
# Remote/Supabase example — keep the +psycopg scheme for the async driver:
# DATABASE_URL=postgresql+psycopg://postgres:<password>@db.<project-ref>.supabase.co:5432/postgres
DEBUG=false
ENVIRONMENT=development

JWT_SECRET_KEY=change-me-to-a-long-random-string-32-plus-bytes
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=30
REFRESH_TOKEN_EXPIRE_DAYS=30

# Supabase REST/Auth client (anon/publishable key).
SUPABASE_URL=https://ifzbxwweznimhitbagzq.supabase.co
SUPABASE_KEY=sb_publishable_y9trecesWRPY7t97N68xRA_O5cXsSGB
